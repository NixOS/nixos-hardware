+static void bq25700_charge_control_work(struct work_struct *work)
+{
+	struct bq25700_device *bq =
+		container_of(work, struct bq25700_device, charge_control_work.work);
+	union power_supply_propval capacity;
+	int ret, limit = bq->charge_control_limit, start = bq->charge_control_start;
+
+	if (limit >= 100 || limit < 0 || IS_ERR_OR_NULL(bq->battery)) {
+		bq25700_field_write(bq, CHRG_INHIBIT, 0);
+		return;
+	}
+
+	if (start == 0 || start >= limit)
+		start = limit - 5;
+	if (start < 0)
+		start = 0;
+
+	ret = bq->battery->desc->get_property(bq->battery,
+					      POWER_SUPPLY_PROP_CAPACITY,
+					      &capacity);
+	if (ret < 0)
+		goto reschedule;
+
+	if (capacity.intval >= limit)
+		bq25700_field_write(bq, CHRG_INHIBIT, 1);
+	else if (capacity.intval < start)
+		bq25700_field_write(bq, CHRG_INHIBIT, 0);
+
+reschedule:
+	schedule_delayed_work(&bq->charge_control_work,
+			      msecs_to_jiffies(60000));
+}
+
+static int bq25700_power_supply_set_property(struct power_supply *psy,
+					     enum power_supply_property psp,
+					     const union power_supply_propval *val)
+{
+	struct bq25700_device *bq = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		if (val->intval < 0 || val->intval > 100)
+			return -EINVAL;
+		bq->charge_control_limit = val->intval;
+		if (bq->charge_control_limit >= 100) {
+			cancel_delayed_work_sync(&bq->charge_control_work);
+			bq25700_field_write(bq, CHRG_INHIBIT, 0);
+		} else {
+			mod_delayed_work(system_wq, &bq->charge_control_work,
+					 msecs_to_jiffies(1000));
+		}
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		if (val->intval < 0 || val->intval > 100)
+			return -EINVAL;
+		bq->charge_control_start = val->intval;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int bq25700_power_supply_property_is_writeable(struct power_supply *psy,
+						     enum power_supply_property psp)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		return 1;
+	default:
+		return 0;
+	}
+}
