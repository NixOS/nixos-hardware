From: Cody McGinnis <brainwart@gmail.com>
Subject: [PATCH] PCI: qcom: drop the required-opps CX vote in system suspend

qcom_pcie_suspend_noirq() only drops the controller's performance vote
when an OPP table is present (use_pm_opp). SC8280XP has no OPP table for
its PCIe controllers. Their vote comes from "required-opps" (nominal on
CX), which genpd applies at attach and only drops on runtime suspend. The
controllers stay runtime active across system suspend. Even after the
D3cold path has turned off the link, PHY, clocks and supplies, CX stays
voted at nominal through s2idle and the SoC never reaches CX collapse.

On a ThinkPad X13s, an rpmh trace across s2idle showed no CX (cx.lvl)
request at all while the controllers held 256 on the cx domain.

Drop the vote with dev_pm_genpd_set_performance_state() when there is no
OPP table. Restore the "required-opps" level on resume before the
controller is powered up again.
---
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -25,6 +25,7 @@
 #include <linux/pci.h>
 #include <linux/pci-ecam.h>
 #include <linux/pci-pwrctrl.h>
+#include <linux/pm_domain.h>
 #include <linux/pm_opp.h>
 #include <linux/pm_runtime.h>
 #include <linux/platform_device.h>
@@ -2340,6 +2341,34 @@
 	return ret;
 }
 
+/*
+ * Without an OPP table the CX vote comes from the "required-opps" of the
+ * controller node, which genpd applies at attach and only drops on runtime
+ * suspend. The controller stays runtime active across system suspend, so
+ * drop and restore that vote here, like the OPP case does.
+ */
+static void qcom_pcie_drop_perf_state(struct qcom_pcie *pcie, struct device *dev)
+{
+	if (pcie->use_pm_opp)
+		dev_pm_opp_set_opp(dev, NULL);
+	else
+		dev_pm_genpd_set_performance_state(dev, 0);
+}
+
+static int qcom_pcie_restore_perf_state(struct qcom_pcie *pcie, struct device *dev)
+{
+	int pstate;
+
+	if (pcie->use_pm_opp)
+		return qcom_pcie_set_max_opp(dev);
+
+	pstate = of_get_required_opp_performance_state(dev->of_node, 0);
+	if (pstate <= 0)
+		return 0;
+
+	return dev_pm_genpd_set_performance_state(dev, pstate);
+}
+
 static int qcom_pcie_suspend_noirq(struct device *dev)
 {
 	struct qcom_pcie *pcie;
@@ -2362,8 +2391,7 @@
 		if (ret)
 			dev_err(dev, "Failed to disable CPU-PCIe interconnect path: %d\n", ret);
 
-		if (pcie->use_pm_opp)
-			dev_pm_opp_set_opp(pcie->pci->dev, NULL);
+		qcom_pcie_drop_perf_state(pcie, dev);
 	} else {
 		/*
 		 * Set minimum bandwidth required to keep data path
@@ -2391,8 +2419,7 @@
 				dev_err(dev, "Failed to disable CPU-PCIe interconnect path: %d\n",
 					ret);
 
-			if (pcie->use_pm_opp)
-				dev_pm_opp_set_opp(pcie->pci->dev, NULL);
+			qcom_pcie_drop_perf_state(pcie, dev);
 		}
 	}
 	return ret;
@@ -2408,12 +2435,10 @@
 		return 0;
 
 	if (pcie->pci->suspended) {
-		if (pcie->use_pm_opp) {
-			ret = qcom_pcie_set_max_opp(dev);
-			if (ret) {
-				dev_err(dev, "Failed to set max OPP: %d\n", ret);
-				return ret;
-			}
+		ret = qcom_pcie_restore_perf_state(pcie, dev);
+		if (ret) {
+			dev_err(dev, "Failed to restore performance state: %d\n", ret);
+			return ret;
 		}
 
 		ret = icc_enable(pcie->icc_cpu);
@@ -2437,12 +2462,10 @@
 			goto disable_icc_mem;
 	} else {
 		if (pm_suspend_target_state != PM_SUSPEND_MEM) {
-			if (pcie->use_pm_opp) {
-				ret = qcom_pcie_set_max_opp(dev);
-				if (ret) {
-					dev_err(dev, "Failed to set max OPP: %d\n", ret);
-					return ret;
-				}
+			ret = qcom_pcie_restore_perf_state(pcie, dev);
+			if (ret) {
+				dev_err(dev, "Failed to restore performance state: %d\n", ret);
+				return ret;
 			}
 
 			ret = icc_enable(pcie->icc_cpu);
